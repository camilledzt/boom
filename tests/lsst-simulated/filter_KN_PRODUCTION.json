    "$addFields": {
      "Gaia_High_PM_SNR3": {
        "$anyElementTrue": {
          "$map": {
            "input": {
              "$ifNull": [
                "$cross_matches.Gaia_DR3",
                []
              ]
            },
            "in": {
              "$and": [
                {
                  "$gt": [
