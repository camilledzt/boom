              "$gt": [
                {
                  "$abs": {
                    "$divide": [
                      "$$this.parallax",
                      "$$this.parallax_error"
                    ]
                  }
                },
                5
              ]
            }
          }
        }
      },
      "TwoMass_Red_Star_IR": {
        "$anyElementTrue": {
          "$map": {
            "input": {
